{
  "SessionStart": [
    {
      "matcher": "startup|resume|clear|compact",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/vercel-plugin/hooks/session-start-seen-skills.mjs\""
        },
        {
          "type": "command",
          "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/vercel-plugin/hooks/session-start-profiler.mjs\""
        },
        {
          "type": "command",
          "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/vercel-plugin/hooks/inject-claude-md.mjs\""
        }
      ],
      "_apm_source": "vercel/vercel-plugin"
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Skill",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/vercel-plugin/hooks/posttooluse-skill-telemetry.mjs\"",
          "timeout": 5
        }
      ],
      "_apm_source": "vercel/vercel-plugin"
    }
  ],
  "SessionEnd": [
    {
      "matcher": "*",
      "hooks": [
        {
          "type": "command",
          "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/vercel-plugin/hooks/session-end-cleanup.mjs\""
        }
      ],
      "_apm_source": "vercel/vercel-plugin"
    }
  ]
}

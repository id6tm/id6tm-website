---
import Diagoriente from "@assets/heroes/diagoriente.png?url";
import CtaSection from "@components/diagoriente/CtaSection.astro";
import IntroductionSection from "@components/diagoriente/IntroductionSection.astro";
import KpisSection from "@components/diagoriente/KpisSection.astro";
import ProfessionalsSection from "@components/diagoriente/ProfessionalsSection.astro";
import QnaSection from "@components/diagoriente/QnaSection.astro";
import RessourcesSection from "@components/diagoriente/RessourcesSection.astro";
import AppLayout from "@layouts/AppLayout.astro";
import Hero from "@ui/Hero.astro";
import ArrowSquareOut from "phosphor-astro/ArrowSquareOut.astro";
---

<AppLayout
	title="Diagoriente : service public pour l'orientation professionnelle"
	desc="Découvrez Diagoriente, le service public numérique pour valoriser les compétences et accompagner les transitions professionnelles."
>
	<Hero
		title="Diagoriente, soutenir les transitions professionnelles"
		subTitle="Diagoriente est un service public qui soutient le pouvoir d'agir des individus et accompagne la construction de parcours professionnels."
		image={{
			src: Diagoriente,
			alt: "diagoriente-banner",
		}}
		buttonProps={{
			href: "https://plateforme.diagoriente.fr/",
			label: "Accéder",
			Icon: ArrowSquareOut,
		}}
	/>

	<IntroductionSection />

	<KpisSection />

	<ProfessionalsSection />

	<RessourcesSection />

	<QnaSection />

	<CtaSection />
</AppLayout>

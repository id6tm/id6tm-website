---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-shell">
		<div class="ambient ambient-one" aria-hidden="true"></div>
		<div class="ambient ambient-two" aria-hidden="true"></div>

		<section class="hero" aria-labelledby="hero-title">
			<h1 id="hero-title">Site en <span>construction</span></h1>
		</section>
	</main>
</Layout>

<style>
	:global(*) { box-sizing: border-box; }
	:global(html) { min-width: 320px; background: #fbf8f4; }
	:global(body) { margin: 0; color: #211c19; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
	.page-shell { position: relative; display: flex; min-height: 100svh; flex-direction: column; overflow: hidden; padding: 34px 6.1vw 27px; isolation: isolate; }
	.ambient { position: absolute; z-index: -1; border-radius: 50%; pointer-events: none; }
	.ambient-one { width: min(62vw, 760px); aspect-ratio: 1; top: -31%; right: -18%; background: radial-gradient(circle, rgba(239, 73, 26, .105), rgba(239, 73, 26, .025) 48%, transparent 70%); }
	.ambient-two { width: 38vw; aspect-ratio: 1; bottom: -36%; left: -19%; background: radial-gradient(circle, rgba(239, 73, 26, .07), transparent 68%); }
	.hero { width: min(1000px, 100%); margin: auto; padding: 78px 0 94px; }
	h1 { margin: 0; font-size: clamp(42px, 7.4vw, 92px); font-weight: 540; letter-spacing: -.075em; line-height: 1; }
	h1 span { color: #ed4a1c; }
	@media (min-width: 1200px) { .hero { transform: translateY(-1.5vh); } }
	@media (max-width: 600px) {
		.page-shell { padding: 24px 24px 23px; }
		.hero { padding: 52px 0 62px; }
		h1 { font-size: clamp(42px, 10vw, 60px); }
		.ambient-one { width: 105vw; top: -12%; right: -56%; }
	}
	@media (prefers-reduced-motion: no-preference) {
		.hero > * { animation: appear .7s both; }
		.hero > :nth-child(2) { animation-delay: .08s; }
		.hero > :nth-child(3) { animation-delay: .16s; }
		.hero > :nth-child(4) { animation-delay: .24s; }
		@keyframes appear { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
	}
</style>

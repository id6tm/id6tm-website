---
import Diagoriente from "@assets/diagoriente.png";
import Button from "@ui/Button.svelte";
import Card from "@ui/Card.astro";
import Tag from "@ui/Tag.astro";
import Shrimp from "phosphor-astro/Shrimp.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout>
	<main class="px-30 py-10 max-md:p-3">
		<section class="flex flex-col gap-4">
			<h1 class="text-h1">
				Site en {" "}
				<span class="text-orange">construction</span>
			</h1>

			<div class="flex gap-6 max-md:flex-col">
				<Card
					color="blue"
					title="Diagoriente"
					description="Soutenir les transitions professionnelles"
					imageSrc={Diagoriente}
				>
					<Tag slot="card-category-tag">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Tag slot="card-subject-tag" color="blue">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Button slot="card-mobile-button" variant="transparent" color="black">
						<Shrimp slot="btnIcon" />
						Show more</Button
					>
				</Card>
				<Card
					orientation="horizontal"
					color="blue"
					title="Diagoriente"
					description="Soutenir les transitions professionnelles"
					imageSrc={Diagoriente}
				>
					<Tag slot="card-category-tag">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Tag slot="card-subject-tag" color="blue">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Button slot="card-mobile-button" variant="transparent" color="black">
						<Shrimp slot="btnIcon" />
						Show more</Button
					>
				</Card>
			</div>
			<div class="flex gap-6 max-md:flex-col">
				<Card
					color="blue"
					title="Diagoriente"
					description="Soutenir les transitions professionnelles"
					imageSrc="https://as2.ftcdn.net/v2/jpg/02/77/81/69/1000_F_277816957_9D8bIwXGdKzzMeTttNJXDb8c9DqGwEtv.jpg"
				>
					<Tag slot="card-category-tag">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Tag slot="card-subject-tag" color="blue">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Button slot="card-mobile-button" variant="transparent" color="black">
						<Shrimp slot="btnIcon" />
						Show more</Button
					>
				</Card>
				<Card
					orientation="horizontal"
					color="blue"
					title="Diagoriente"
					description="Soutenir les transitions professionnelles"
					imageSrc="https://as2.ftcdn.net/v2/jpg/02/77/81/69/1000_F_277816957_9D8bIwXGdKzzMeTttNJXDb8c9DqGwEtv.jpg"
				>
					<Tag slot="card-category-tag">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Tag slot="card-subject-tag" color="blue">
						<Shrimp slot="tag-icon" />
						<span slot="tag-label">tag</span>
					</Tag>
					<Button slot="card-mobile-button" variant="transparent" color="black">
						<Shrimp slot="btnIcon" />
						Show more</Button
					></Card
				>
			</div>
			<div class="flex items-end gap-6"></div>
		</section>
	</main>
</Layout>

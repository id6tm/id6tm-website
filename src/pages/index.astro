---
import HomeHeroeImage from "@assets/heroes/home.png?url";
import HomeKpis from "@components/Home/HomeKpis.astro";
import NewsSection from "@components/Home/NewsSection.astro";
import PartnersSection from "@components/Home/PartnersSection.astro";
import ProjectsSection from "@components/Home/ProjectsSection.astro";
import TeamSection from "@components/Home/TeamSection.astro";
import AppLayout from "@layouts/AppLayout.astro";
import Hero from "@ui/Hero.astro";
---

<AppLayout>
	<main class="flex flex-col">
		<Hero
			title="L’innovation au service des transitions professionnelles"
			subTitle="Depuis plus de 25 ans, id6 éclaire l’orientation et accompagne les parcours professionnels."
			image={{
				src: HomeHeroeImage,
				alt: "id6-banner",
			}}
		/>

		<HomeKpis />

		<ProjectsSection />

		<TeamSection />

		<PartnersSection />

		<NewsSection />
	</main>
</AppLayout>

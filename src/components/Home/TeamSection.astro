---
import { Image } from "astro:assets";
import TeamImage from "@assets/team.jpg";
import Button from "@ui/Button.svelte";
import Chats from "phosphor-astro/Chats.astro";
import Plus from "phosphor-astro/Plus.astro";
---

<section
	class="flex items-center gap-31.5 p-30 max-lg:justify-between max-lg:gap-0 max-lg:px-12 max-lg:py-22.5 max-md:flex-col max-md:gap-15 max-md:px-22.5 max-md:py-12 max-sm:gap-10 max-sm:px-5 max-sm:py-15"
>
	<div class="flex flex-col gap-18">
		<div class="flex flex-col gap-12">
			<h2 class="text-h1 max-sm:text-h2-5">Notre équipe</h2>
			<p class="text-t2 max-sm:text-t3">
				id6 rassemble une équipe de plus de 30 personnes (salariés et
				indépendants) autour de ses projets et se développe avec un ensemble de
				partenaires publics et privés.
			</p>
		</div>
		<div class="flex gap-4 max-md:hidden">
			<a href="#">
				<Button client:visible>
					En savoir plus
					<Plus slot="btnIcon" />
				</Button>
			</a>
			<a href="#">
				<Button client:visible variant="stroke">
					Contact
					<Chats slot="btnIcon" />
				</Button>
			</a>
		</div>
	</div>

	<Image
		src={TeamImage}
		alt="team image"
		class="size-147 max-xl:size-113.5 max-lg:size-87.5"
	/>

	<div class="flex gap-3 md:hidden">
		<a href="#">
			<Button client:visible>
				En savoir plus
				<Plus slot="btnIcon" />
			</Button>
		</a>
		<a href="#">
			<Button client:visible variant="stroke">
				Contact
				<Chats slot="btnIcon" />
			</Button>
		</a>
	</div>
</section>

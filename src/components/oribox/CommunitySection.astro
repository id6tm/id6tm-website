---
import { Image } from "astro:assets";
import Workshop from "@assets/oribox/workshop.jpg";
import SideBySideLayout from "@layouts/SideBySideLayout.astro";
import Button from "@ui/Button.svelte";
import LinkedInLogo from "phosphor-astro/LinkedInLogo.astro";
---

<SideBySideLayout>
	<Image
		slot="left-content"
		src={Workshop}
		alt="oribox-workshop"
		class="size-147 object-contain max-xl:size-113.5 max-lg:size-87.5"
	/>

	<div slot="right-content" class="flex flex-col gap-12">
		<h2 class="text-h1 max-sm:text-h2-5">Une communauté dédiée</h2>
		<p class="text-t2 max-sm:text-t3">
			La{" "}<b>communauté Oribox</b>{" "}réunit les professionnels qui
			utilisent le kit pour partager leurs expériences, leurs animations et
			leurs bonnes pratiques. Un espace d’échange pour{" "}<b>s’inspirer</b>
			{" "}et{" "}<b>faire évoluer les usages</b>{" "}d’Oribox ensemble.
		</p>
		<a href="https://www.linkedin.com/groups/26410135/"
			><Button color="black">
				Rejoindre la communauté Oribox
				<LinkedInLogo slot="btnIcon" />
			</Button></a
		>
	</div>
</SideBySideLayout>

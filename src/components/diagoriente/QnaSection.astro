import Qna from "@components/Qna.astro";
---

<Qna
	topic="le projet Diagoriente"
	items={[
		{
			title: "Qu'est-ce que Diagoriente ?",
			content:
				"<p>Diagoriente est un service public numérique dédié à l'orientation, à l'insertion et aux transitions professionnelles.<br/><br/>Il propose des outils pour identifier et valoriser ses compétences, explorer ses centres d'intérêt, découvrir des métiers et construire son projet professionnel, ainsi que des ressources pour les professionnels de la chaîne formation-insertion-emploi.</p>",
		},
		{
			title: "Qui est à l'origine de Diagoriente ?",
			content:
				"<p>Diagoriente est une initiative d'id6, développée à partir de son expertise sur les sujets d’orientation professionnelle et de valorisation des compétences.<br/><br/>Lancé en 2018 dans le cadre du Plan d'Investissement dans les Compétences, le projet a intégré le programme des start-up d'État beta.gouv.<br/><br/>Il est aujourd'hui porté et financé par la Délégation Générale à l'Emploi et à la Formation Professionnelle (DGEFP) du ministère du Travail.<br/><br/></p>",
		},
		{
			title: "À qui s'adresse Diagoriente ?",
			content:
				"<p>Diagoriente s'adresse à toute personne qui souhaite réfléchir à son orientation ou à son évolution professionnelle, qu'elle soit en recherche d'emploi, en insertion, en formation ou en reconversion.<br/><br/>Le service propose également des outils et des ressources aux professionnels qui accompagnent ces transitions.</p>",
		},
		{
			title: "Les services Diagoriente sont-ils gratuits ?",
			content:
				"<p>Oui. Diagoriente est un service public qui propose gratuitement des plateformes numériques et des ressources pédagogiques pour accompagner l'orientation et l'insertion professionnelle.<br/><br/>Des prestations complémentaires de formation et d'accompagnement sont également proposées aux structures professionnelles.</p>",
		},
		{
			title: "Quelle est la démarche pédagogique de Diagoriente ?",
			content:
				"<p>La démarche de Diagoriente repose sur l'expérience accompagnée. Elle considère que les expériences personnelles, professionnelles ou d'engagement constituent des ressources pour mieux se connaître et construire son avenir.<br/><br/>L'objectif n'est pas de déterminer une orientation à la place de la personne, mais de l'aider à identifier ses compétences, à comprendre ses intérêts et à explorer différentes possibilités pour faire ses propres choix.</p>",
		},
	]}
/>

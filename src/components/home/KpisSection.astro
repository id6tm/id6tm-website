---
import SectionLayout from "@layouts/SectionLayout.astro";
import Tile from "@ui/Tile.astro";
import Medal from "phosphor-astro/Medal.astro";
import ToggleLeft from "phosphor-astro/ToggleLeft.astro";
import UsersFour from "phosphor-astro/UsersFour.astro";
import UsersThree from "phosphor-astro/UsersThree.astro";
---

<SectionLayout
	title="id6 en chiffres"
	subTitle="L’innovation pédagogique et numérique au cœur d’id6."
>
	<div
		class="flex justify-center gap-6 max-lg:flex-wrap max-lg:gap-5 max-sm:gap-3"
	>
		<div
			class="reveal-item translate-y-30 opacity-0 transition-all duration-700 ease-out"
			style="transition-delay: 0ms"
		>
			<Tile
				kpi="+1M"
				title="Personnes touchées"
				description="Des dispositifs à l’impact social éprouvé."
			>
				<UsersFour slot="tile-icon" />
			</Tile>
		</div>
		<div
			class="reveal-item translate-y-30 opacity-0 transition-all duration-700 ease-out"
			style="transition-delay: 300ms"
		>
			<Tile
				kpi="2000"
				title="Année de création"
				description="Des années de création et d’innovation."
			>
				<ToggleLeft slot="tile-icon" />
			</Tile>
		</div>
		<div
			class="reveal-item translate-y-30 opacity-0 transition-all duration-700 ease-out"
			style="transition-delay: 600ms"
		>
			<Tile
				kpi="24"
				title="Membres de l’association"
				description="Des expertises complémentaires."
			>
				<UsersThree slot="tile-icon" />
			</Tile>
		</div>
		<div
			class="reveal-item translate-y-30 opacity-0 transition-all duration-700 ease-out"
			style="transition-delay: 900ms"
		>
			<Tile
				kpi="16"
				title="Projets primés en Europe"
				description="Des innovations reconnues."
			>
				<Medal slot="tile-icon" />
			</Tile>
		</div>
	</div>
</SectionLayout>

<script>
const observer = new IntersectionObserver(
	(entries) => {
		entries.forEach((entry) => {
			if (entry.isIntersecting) {
				// Remove the initial offset and add the final position
				entry.target.classList.remove("translate-y-30");
				entry.target.classList.add("opacity-100", "translate-y-0");
				observer.unobserve(entry.target);
			}
		});
	},
	{ threshold: 0.1 },
);

document.querySelectorAll(".reveal-item").forEach((el) => {
	observer.observe(el);
});
</script>

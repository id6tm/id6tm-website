---
import { Font } from "astro:assets";
import "../styles/global.css";
import Footer from "@components/Footer.astro";
import Header from "@components/Header/Header.svelte";

interface Props {
	title: string;
	desc: string;
}
const { title, desc } = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<meta name="theme-color" content="#fbf8f4">
		<Font cssVariable="--font-redhat" preload />
		<Font cssVariable="--font-outfit" preload />
		<Font cssVariable="--font-grotesk" preload />
		<title>{title}</title>
		<meta name="description" content={desc}>
	</head>
	<body class="font-redhat text-black">
		<Header client:load />
		<main class="flex flex-col"><slot /></main>
		<Footer />
	</body>
</html>

---
import { Image } from "astro:assets";
import { cn } from "@utils/cn";
import type { ImageMetadata } from "astro";
import { cardColors } from "./constants";

const cardOrientations = {
	HORIZONTAL: "horizontal",
	VERTICAL: "vertical",
} as const;
type CardOrientation = (typeof cardOrientations)[keyof typeof cardOrientations];

type CardColor = (typeof cardColors)[keyof typeof cardColors];

const cardColorVars: Record<CardColor, string> = {
	[cardColors.BLUE]: "var(--color-blue)",
	[cardColors.ORANGE]: "var(--color-orange)",
	[cardColors.YELLOW]: "var(--color-yellow)",
} as const;

interface Props {
	title: string;
	description: string;
	color: CardColor;
	imageSrc: string | ImageMetadata;
	/**
	 * default — vertical
	 */
	orientation?: CardOrientation;
}

const {
	color,
	description,
	imageSrc,
	title,
	orientation = cardOrientations.VERTICAL,
} = Astro.props;

// Determine if the image is a remote URL (CMS) or a local path
const isRemote = typeof imageSrc === "string";
---

<!-- colored wrapper -->
<div
	data-card-wrapper
	class="group relative h-fit w-fit rounded-3xl"
	style={`--card-accent: ${cardColorVars[color]}; background-color: var(--card-accent);`}
>
	<!-- card animée -->
	<div
		data-card-surface
		class={cn(
			"flex items-center gap-8 rounded-3xl border border-[#C8C8C8] bg-white p-8 pt-5 will-change-[translate,rotate]",
			"transition-[translate,rotate,border-color] duration-300 ease-out",
			"group-hover:ease-card-bump group-hover:border-(--card-accent) group-hover:duration-650",
			"group-hover:translate-x-(--tx,12px) group-hover:translate-y-(--ty,-12px) group-hover:rotate-(--rot,2deg)",
			"motion-reduce:transition-none motion-reduce:group-hover:transform-none",
			"max-md:p-6 max-sm:px-4 max-sm:pt-3 max-sm:pb-5",
			orientation === cardOrientations.VERTICAL
				? "w-[384px] flex-col max-md:w-74 max-sm:w-65"
				: "w-147 max-md:w-113.5 max-sm:w-87.5",
		)}
	>
		<!-- card image -->
		{isRemote ? (
			<div
				class={cn(
					orientation === cardOrientations.VERTICAL
						? "h-47.75 w-86 max-md:h-37.75 max-md:w-68 max-sm:h-32.75 max-sm:w-59"
						: "h-39 w-39 max-sm:h-24 max-sm:w-24",
				)}
			>
				<img src={imageSrc} alt={title} class="h-full w-full object-contain" />
			</div>
		) : (
			<Image
				src={imageSrc}
				alt={title}
				class={cn(
					"object-contain",
					orientation === cardOrientations.VERTICAL
						? "h-47.75 w-86 max-md:h-37.75 max-md:w-68 max-sm:h-32.75 max-sm:w-59"
						: "max-sm:h-24 max-sm:w-24",
				)}
			/>
		)}

		<!-- card content -->
		<div
			class={cn(
				"flex flex-col gap-6",
				orientation === cardOrientations.HORIZONTAL && "py-3",
			)}
		>
			{orientation === cardOrientations.VERTICAL && (
				<div class="flex items-center justify-between">
					<slot name="card-category-tag" />
					<slot name="card-subject-tag" />
				</div>
			)}
			<h6 class="text-h2-5 max-sm:text-h3-mobile">{title}</h6>
			<p class="text-t2 max-md:text-t3 max-sm:text-t3-mobile">{description}</p>
			{orientation === cardOrientations.VERTICAL && (
				<div class="self-end md:hidden">
					<slot name="card-mobile-button" />
				</div>
			)}
		</div>
	</div>
</div>

<script>
function initDirectionalCards() {
	// Select all card wrappers in the DOM
	const wrappers = document.querySelectorAll<HTMLElement>(
		"[data-card-wrapper]",
	);

	wrappers.forEach((wrapper) => {
		// Prevent attaching duplicate event listeners (e.g., during Astro View Transitions)
		if (wrapper.dataset.bound) return;
		wrapper.dataset.bound = "true";

		// Get the inner white card surface that will actually move and rotate
		const surface = wrapper.querySelector<HTMLElement>("[data-card-surface]");
		if (!surface) return;

		// Listen on the static outer wrapper so the hover zone doesn't shift while the card moves
		wrapper.addEventListener("mouseenter", (e) => {
			// Measure the wrapper's exact position and dimensions in the viewport
			const rect = wrapper.getBoundingClientRect();
			const centerX = rect.left + rect.width / 2;
			const centerY = rect.top + rect.height / 2;

			// Compute cursor entry position relative to the card center, normalized between -1 and 1
			const dx = (e.clientX - centerX) / (rect.width / 2);
			const dy = (e.clientY - centerY) / (rect.height / 2);

			// Normalize the vector length so corner entries and edge entries travel the exact same distance
			const length = Math.hypot(dx, dy) || 1;

			// Maximum offset (in pixels) and tilt angle (in degrees)
			const maxOffset = 14;
			const maxAngle = 2.5;

			// Invert the vector (-dx, -dy) so the card moves away from where the cursor entered
			const tx = ((-dx / length) * maxOffset).toFixed(1);
			const ty = ((-dy / length) * maxOffset).toFixed(1);
			const rot = ((-dx / length) * maxAngle).toFixed(2);

			// Pass the calculated values to CSS custom properties consumed by Tailwind's group-hover utilities
			surface.style.setProperty("--tx", `${tx}px`);
			surface.style.setProperty("--ty", `${ty}px`);
			surface.style.setProperty("--rot", `${rot}deg`);
		});
	});
}

// Run on initial page load
initDirectionalCards();

// Re-run after client-side navigation if Astro View Transitions (<ClientRouter />) are enabled
document.addEventListener("astro:page-load", initDirectionalCards);
</script>

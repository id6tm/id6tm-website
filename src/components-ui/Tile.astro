---
interface Props {
	kpi: string;
	title: string;
	description: string;
}
const { kpi, title, description } = Astro.props;
---

<div
	class="bg-hover-gradient flex w-42.25 flex-col gap-4 rounded-3xl p-6 md:w-52.25 lg:w-70.5 lg:p-8"
>
	<!-- icon slot -->
	<div class="text-orange [&>svg]:size-6 lg:[&>svg]:size-9">
		<slot name="tile-icon" />
	</div>

	<div class="flex flex-col gap-4 max-md:gap-3">
		<h1 class="max-md:text-h2 max-sm:text-h2-5 text-h1 text-orange">{kpi}</h1>
		<h2 class="max-sm:text-h3-mobile text-h2-5 max-md:text-h3">{title}</h2>
		<p class="max-sm:text-t3-mobile text-t3">{description}</p>
	</div>
</div>

---
interface Props {
	kpi: number;
	title: string;
	description: string;
}
const { kpi, title, description } = Astro.props;
---

<div
	class="bg-hover-gradient flex w-42.25 flex-col gap-4 rounded-3xl p-6 md:w-52.25 lg:w-70.5 lg:p-8"
>
	<!-- icon slot -->
	<div class="text-orange [&>svg]:h-6 lg:[&>svg]:h-9">
		<slot name="tile-icon" />
	</div>

	<div class="flex flex-col gap-4">
		<h1 class="text-h2.5 md:text-h2 lg:text-h1 text-orange">{kpi}</h1>
		<h2 class="text-h3-mobile lg:text-h2-5 md:text-h3">{title}</h2>
		<p class="text-t3-mobile md:text-t3">{description}</p>
	</div>
</div>
